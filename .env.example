# ไม่ต้องสร้าง env หากใช้ npm run dev:local (ข้าม env ทั้งหมด ใช้ AI จำลอง)
# ไฟล์นี้เป็นตัวอย่างสำหรับปรับค่าเองด้วย npm run dev เท่านั้น
# Cloud: ใช้ npm run setup:cloud หรือดู .env.cloud.example แทน
# ห้าม commit .env.local และห้ามทับไฟล์ที่มีอยู่แล้วโดยไม่ตรวจ
VITE_APP_MODE=local
VITE_API_BASE_URL=/api/v1

# Cloud mode (Google OAuth + server bootstrap; publishable key เปิดเผยใน browser ได้ แต่ไม่ใช่ secret)
# VITE_APP_MODE=cloud
# VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=

# Server runtime — staging/production ต้องระบุ allowlist และ Supabase server credentials
APP_ENV=development
# APP_ALLOWED_ORIGINS=https://staging.example.com,https://app.example.com
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_SECRET_KEY=
# DATABASE_URL=postgresql://... # tooling/local migration เท่านั้น
#
# --- AI ---
# ANTHROPIC_API_KEY = คีย์ Anthropic "ของระบบ" ฝั่ง server (ห้ามใส่ใน VITE_*)
# - Cloud (VITE_APP_MODE=cloud): /api/v1/ai/box-spec ใช้คีย์นี้เท่านั้น ไม่รับคีย์จากผู้ใช้
#   ไม่ตั้ง → แถบ AI บน cloud ตอบ 503 CONFIGURATION_ERROR; เครดิต AI ต่อ workspace ดู docs/billing-freemium-pro.md
# - Local demo (/api/box-spec): ค่าเริ่มต้นในตัวอย่างนี้ใช้ AI จำลอง ไม่เรียก API/CLI โดยอัตโนมัติ
#   ถ้าต้องการใช้คีย์นี้ให้เลือก BOX_SPEC_BACKEND=api; ใช้ Claude CLI ที่ login ไว้ให้เลือก BOX_SPEC_BACKEND=cli
#   ถ้าไม่กำหนด backend ระบบเลือก API key → CLI → mock ตามที่มีในเครื่อง
#   เฉพาะ local demo เท่านั้นที่ใส่ Anthropic API key ในแถบ AI ได้ (BYOK); คีย์อยู่เฉพาะ memory ของแท็บ
#   และส่งไป /api/box-spec ตอนกดสร้างเท่านั้น ไม่บันทึกลง browser storage
# บังคับ backend ของ local demo ได้ด้วย BOX_SPEC_BACKEND=api|cli|mock

ANTHROPIC_API_KEY=
BOX_SPEC_BACKEND=mock

# สำหรับ backend cli: ปกติ CLI ใช้ login จาก Keychain อัตโนมัติ
# แต่ถ้าเจอ 401 (token หมดอายุ / Keychain อ่านไม่ได้) ให้รัน `claude setup-token`
# ใน terminal แล้วเอา token ที่ได้ (ขึ้นต้น sk-ant-oat01-) มาใส่ตรงนี้:
# CLAUDE_CODE_OAUTH_TOKEN=

# โมเดล (ใช้ทั้ง local backend api และ Cloud AI route): ค่าเริ่มต้น claude-opus-4-8 (ประหยัดใช้ claude-haiku-5-5;
# รองรับ claude-opus-5-5 / claude-sonnet-5-5 ด้วย — ข้อแลกเปลี่ยน: docs/billing-freemium-pro.md §6)
# backend cli ค่าเริ่มต้นคือโมเดลที่ตั้งไว้ใน Claude Code (ใส่ alias เช่น haiku/sonnet/opus ได้)
# BOX_SPEC_MODEL=
#
# --- Deploy บน Vercel ---
# /api/box-spec เป็น legacy endpoint: เปิดเฉพาะ local demo ใน development/test
# และตอบ 410 ใน cloud/staging/production
# Cloud ใช้ /api/v1/ai/box-spec พร้อม session จริง + ANTHROPIC_API_KEY ของระบบ (ตั้งใน Vercel env)
# และหักเครดิต AI ของ workspace ต่อคำขอ — ผู้ใช้ไม่กรอกคีย์เองบน cloud อีกต่อไป
