# คัดลอกไฟล์นี้เป็น .env.local แล้วใส่ค่า (ห้าม commit .env.local)
# ค่าเริ่มต้นเป็น local demo: ไม่ใช้บัญชี cloud และไม่ต้องมี credentials
VITE_APP_MODE=local
VITE_API_BASE_URL=/api/v1

# Cloud mode (Google OAuth + server bootstrap; publishable key เปิดเผยใน browser ได้ แต่ไม่ใช่ secret)
# VITE_APP_MODE=cloud
# VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=

# Server runtime — staging/production ต้องระบุ allowlist และ Supabase server credentials
APP_ENV=development
# APP_ALLOWED_ORIGINS=https://staging.example.com,https://app.example.com
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_SECRET_KEY=
# DATABASE_URL=postgresql://... # tooling/local migration เท่านั้น
#
# ลำดับ backend ของ AI (อัตโนมัติ):
#   1. มี ANTHROPIC_API_KEY → เรียก Claude API โดยตรง
#   2. ไม่มี key แต่มีคำสั่ง claude (Claude Code CLI) ในเครื่อง → ใช้ CLI (ใช้ login เดิม ไม่เสียค่า API)
#   3. ไม่มีทั้งคู่ → โหมดจำลอง (ตัวเดาอย่างง่าย)
# บังคับ backend ได้ด้วย BOX_SPEC_BACKEND=api|cli|mock

ANTHROPIC_API_KEY=
# BOX_SPEC_BACKEND=cli

# สำหรับ backend cli: ปกติ CLI ใช้ login จาก Keychain อัตโนมัติ
# แต่ถ้าเจอ 401 (token หมดอายุ / Keychain อ่านไม่ได้) ให้รัน `claude setup-token`
# ใน terminal แล้วเอา token ที่ได้ (ขึ้นต้น sk-ant-oat01-) มาใส่ตรงนี้:
# CLAUDE_CODE_OAUTH_TOKEN=

# โมเดล: backend api ค่าเริ่มต้น claude-opus-4-8 (ประหยัดใช้ claude-haiku-4-5)
# backend cli ค่าเริ่มต้นคือโมเดลที่ตั้งไว้ใน Claude Code (ใส่ alias เช่น haiku/sonnet/opus ได้)
# BOX_SPEC_MODEL=
#
# --- Deploy บน Vercel ---
# /api/box-spec เป็น legacy endpoint: เปิดเฉพาะ local demo ใน development/test
# และตอบ 410 ใน cloud/staging/production จนกว่า Phase 2 จะย้ายเข้า authenticated AI service
