# Optional cloud development. Run npm run setup:cloud, fill .env.local, then npm run dev.
# Never commit .env.local. Use one dedicated development/staging Supabase project.
VITE_APP_MODE=cloud
VITE_API_BASE_URL=/api/v1
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

APP_ENV=development
APP_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# URL values above must refer to the same project.
# Only a publishable/anon key may use VITE_ (browser-visible).
# SUPABASE_SECRET_KEY is server-only; get it securely from the project owner.
# Put Google client ID/secret in Supabase's provider settings, not here.
# Cloud AI uses the user's Anthropic API key from the app UI (memory only).
