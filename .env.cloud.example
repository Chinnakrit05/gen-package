# Optional cloud development. Run npm run setup:cloud, fill .env.local, then npm run dev.
# Never commit .env.local. Use one dedicated development/staging Supabase project.
VITE_APP_MODE=cloud
VITE_API_BASE_URL=/api/v1
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

APP_ENV=development
APP_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# AI บน Cloud ใช้คีย์ Anthropic "ของระบบ" ฝั่ง server เท่านั้น (ไม่ใช่ VITE_*; ผู้ใช้ไม่กรอกคีย์ใน UI)
# ไม่ตั้ง = แถบ AI ตอบ 503 CONFIGURATION_ERROR
# BOX_SPEC_MODEL = รุ่น Claude ของทุกคำขอ AI (1 คำขอ = 1 เครดิตทุกรุ่น — รุ่นมีผลแค่ต้นทุนของเรา/ความเร็ว/คุณภาพ)
#   ว่าง = claude-opus-4-8 ($5/$25 ต่อ 1M โทเคน, ไม่คิดก่อนตอบ — พฤติกรรมเดิม)
#   claude-opus-5-5 ($4/$20) หรือ claude-sonnet-5-5 ($2/$10): คิดก่อนตอบ effort low + ส่งต่อ refusal อัตโนมัติ
#   claude-haiku-5-5 ($0.10/$0.50): ถูกและเร็วสุด คิดก่อนตอบ effort low ไม่มี fallback
#   ข้อแลกเปลี่ยน/วิธีวัดต้นทุนก่อนเลือก: docs/billing-freemium-pro.md §6
ANTHROPIC_API_KEY=
BOX_SPEC_MODEL=

# URL values above must refer to the same project.
# Only a publishable/anon key may use VITE_ (browser-visible).
# SUPABASE_SECRET_KEY is server-only; get it securely from the project owner.
# Put Google client ID/secret in Supabase's provider settings, not here.
# Cloud AI uses the server-side ANTHROPIC_API_KEY above; the app UI no longer accepts a user key
# (BYOK exists only in local demo). Credits per workspace: docs/billing-freemium-pro.md
