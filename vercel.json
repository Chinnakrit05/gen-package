{
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "/api/backend?apiPath=:path*"
    },
    {
      "source": "/((?!api(?:/|$)|assets(?:/|$)|_vercel(?:/|$)|.*\\.).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/backend.js": {
      "maxDuration": 300
    }
  }
}
